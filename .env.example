# Ключ Google Gemini AI (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Service Account в base64
# Получить: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Закодировать: base64 -i serviceAccountKey.json (Mac/Linux)
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json

PORT=3000
