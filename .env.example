# Скопируй в .env на сервере и заполни значения.
# Домен для HTTPS (например academy.i-box.company или <IP-сервера>.sslip.io)
APP_DOMAIN=academy.example.com

NODE_ENV=production
PORT=3000

# PostgreSQL — приватный IP базы Timeweb (сервер в той же приватной сети)
PGHOST=192.168.0.4
PGPORT=5432
PGDATABASE=default_db
PGUSER=gen_user
PGPASSWORD=

# S3 (Timeweb)
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=ibox-academy
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Авторизация / ИИ
JWT_SECRET=
GEMINI_API_KEY=

# Firebase — только для разовой миграции (тот же base64, что в Render, одной строкой)
FIREBASE_SERVICE_ACCOUNT_BASE64=
MIGRATION_KEY=
