rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      let isDev = isSignedIn() && (
        request.auth.token.email == 'oap.ibox.company@gmail.com' ||
        request.auth.token.email == 'pem@i-box.company'
      );
      let isHardcodedUid = isSignedIn() && (
        request.auth.uid == 'bitrix_DxMBjT1L'
      );
      let isRoleAdmin = isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
      let isUsersAdmin = isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
      return isDev || isHardcodedUid || isRoleAdmin || isUsersAdmin;
    }

    function isManager() {
      let isRoleManager = isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'manager';
      let isUsersManager = isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'manager';
      return isAdmin() || isRoleManager || isUsersManager;
    }

    // ── COURSES ──────────────────────────────────────────────────────────
    match /courses/{courseId} {
      // All signed-in users can read; visibility filtering is done client-side
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── USERS ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Any signed-in user can read any profile (needed for managers/anonymous Bitrix fallback)
      allow read: if isSignedIn();
      // Any signed-in user can create their own profile (covers anonymous Bitrix fallback)
      allow create: if isSignedIn();
      allow update: if isAdmin() ||
        (isOwner(userId) && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name','email','position','department','assignedCourses']));
    }

    // ── NOTIFICATIONS ─────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      // read covers both get and list — required for onSnapshot + where queries
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── RESULTS ───────────────────────────────────────────────────────────
    match /results/{resultId} {
      // Deterministic doc id `${userId}_${courseId}` — retakes overwrite the same
      // doc, so signed-in users need update too (anonymous auth UID ≠ bitrix profile
      // id, so per-owner checks can't be enforced — mirrors the progress collection).
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── GLOSSARY ──────────────────────────────────────────────────────────
    match /glossary/{termId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── SETTINGS ──────────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── ROLES ─────────────────────────────────────────────────────────────
    match /roles/{userId} {
      allow read: if true;
      // Any authenticated user can write their own role document
      allow write: if isAdmin() || isOwner(userId);
    }

    // ── SIMULATOR SESSIONS ────────────────────────────────────────────────
    match /simulator_sessions/{sessionId} {
      // Any signed-in user can read — userId filtering done client-side
      // (anonymous auth UID ≠ bitrix_XXX profile ID, so per-doc check fails)
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── PROGRESS ──────────────────────────────────────────────────────────
    match /progress/{progressId} {
      // Any signed-in user can read/write — userId filtering done client-side
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
